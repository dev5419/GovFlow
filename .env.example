# ==============================================================================
# GovFlow Environment Variables — Local Development Defaults
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# Environment Mode
ENVIRONMENT=development
DEBUG=true

# ------------------------------------------------------------------------------
# 1. Primary Database (PostgreSQL 15)
# ------------------------------------------------------------------------------
POSTGRES_USER=govflow
POSTGRES_PASSWORD=govflow_secret
POSTGRES_DB=govflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://govflow:govflow_secret@localhost:5432/govflow

# ------------------------------------------------------------------------------
# 2. Task Queue Broker & Cache (Redis 7)
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. Object Storage (MinIO S3-compatible)
# ------------------------------------------------------------------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=govflow-documents
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# 4. API Gateway & Security
# ------------------------------------------------------------------------------
API_GATEWAY_PORT=8000
JWT_SECRET=govflow_jwt_super_secret_key_change_in_production_min_32_bytes

# ------------------------------------------------------------------------------
# 5. Frontend Web App (Next.js)
# ------------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000