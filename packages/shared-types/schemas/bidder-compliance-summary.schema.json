{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govflow.internal/schemas/bidder-compliance-summary.schema.json",
  "title": "BidderComplianceSummary",
  "description": "Aggregated bidder compliance score and risk summary for the tender dashboard per PRD §8.1 and §10",
  "type": "object",
  "properties": {
    "bidderId": {
      "type": "string",
      "description": "Associated Bidder identifier"
    },
    "tenderId": {
      "type": "string",
      "description": "Associated Tender identifier"
    },
    "bidderName": {
      "type": "string",
      "description": "Legal entity name of the bidder"
    },
    "complianceScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Calculated compliance score percentage (0-100)"
    },
    "totalDocuments": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Total required documents count"
    },
    "submittedDocuments": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Count of documents successfully submitted and verified"
    },
    "missingDocuments": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Count of missing mandatory documents"
    },
    "verifiedFlagsCount": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Count of Verified compliance flags"
    },
    "needsReviewFlagsCount": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Count of Needs Review or low-confidence flags"
    },
    "nonComplianceFlagsCount": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Count of Potential/Confirmed Non-Compliance flags"
    },
    "confirmedFlagsCount": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Count of flags confirmed by officer"
    },
    "unresolvedFlagsCount": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Count of pending flags awaiting officer review"
    },
    "processingStatus": {
      "type": "string",
      "description": "Aggregate processing state (pending, processing, completed, failed)"
    },
    "primaryRiskReasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Summary bullet points of highest severity findings"
    },
    "overallStatus": {
      "type": "string",
      "description": "Tender dashboard status category (Compliant, Needs Review, Non-Compliant, Missing Documents, Processing)"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of summary generation"
    }
  },
  "required": [
    "bidderId",
    "tenderId",
    "bidderName",
    "complianceScore",
    "totalDocuments",
    "submittedDocuments",
    "missingDocuments",
    "verifiedFlagsCount",
    "needsReviewFlagsCount",
    "nonComplianceFlagsCount",
    "confirmedFlagsCount",
    "unresolvedFlagsCount",
    "processingStatus",
    "primaryRiskReasons",
    "overallStatus",
    "updatedAt"
  ],
  "additionalProperties": false
}
