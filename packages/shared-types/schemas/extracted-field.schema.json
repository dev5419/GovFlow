{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govflow.internal/schemas/extracted-field.schema.json",
  "title": "ExtractedField",
  "description": "OCR and Layout-aware extracted field with confidence and coordinate bounding box per PRD §8.3 and §10",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the extracted field"
    },
    "documentId": {
      "type": "string",
      "description": "Associated Document identifier"
    },
    "pageNumber": {
      "type": "integer",
      "minimum": 1,
      "description": "1-based document page number"
    },
    "fieldName": {
      "type": "string",
      "description": "Canonical field identifier (e.g. GSTIN, Udyam Registration Number, Legal Entity Name, Turnover Value, Financial Year)"
    },
    "rawText": {
      "type": "string",
      "description": "Unmodified text detected by OCR"
    },
    "normalizedValue": {
      "description": "Parsed and typed value (string, number, ISO date, object)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Extraction confidence score between 0.0 and 1.0"
    },
    "boundingBox": {
      "type": "object",
      "properties": {
        "pageNumber": { "type": "integer", "minimum": 1 },
        "pageWidth": { "type": "number", "exclusiveMinimum": 0 },
        "pageHeight": { "type": "number", "exclusiveMinimum": 0 },
        "x1": { "type": "number" },
        "y1": { "type": "number" },
        "x2": { "type": "number" },
        "y2": { "type": "number" }
      },
      "required": ["pageNumber", "pageWidth", "pageHeight", "x1", "y1", "x2", "y2"],
      "additionalProperties": false,
      "description": "Bounding box coordinates on the document page per PRD §12.3"
    },
    "extractionMethod": {
      "type": "string",
      "description": "Model or pipeline used (e.g. paddle_ocr, layoutlmv3, rule_based, hybrid)"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of extraction"
    }
  },
  "required": [
    "id",
    "documentId",
    "pageNumber",
    "fieldName",
    "rawText",
    "confidence",
    "boundingBox",
    "extractionMethod",
    "createdAt"
  ],
  "additionalProperties": false
}