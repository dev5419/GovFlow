{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govflow.internal/schemas/required-document.schema.json",
  "title": "RequiredDocument",
  "description": "Definition of mandatory or optional document types for a tender per PRD §10",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the required document rule"
    },
    "tenderId": {
      "type": "string",
      "description": "Associated Tender identifier"
    },
    "documentType": {
      "type": "string",
      "description": "Canonical document category (e.g. GST Certificate, CA Certificate, Udyam Registration)"
    },
    "displayName": {
      "type": "string",
      "description": "User-facing label for the document requirement"
    },
    "description": {
      "type": "string",
      "description": "Guidelines or expectations for this document"
    },
    "isRequired": {
      "type": "boolean",
      "default": true,
      "description": "Whether document submission is mandatory"
    },
    "allowedExtensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Permitted file extensions (e.g. ['.pdf', '.png', '.jpg'])"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of creation"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    }
  },
  "required": [
    "id",
    "tenderId",
    "documentType",
    "displayName",
    "isRequired",
    "allowedExtensions",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
