{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govflow.internal/schemas/document.schema.json",
  "title": "Document",
  "description": "Uploaded bidder document record in object storage per PRD §10",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the document"
    },
    "tenderId": {
      "type": "string",
      "description": "Associated Tender identifier"
    },
    "bidderId": {
      "type": "string",
      "description": "Associated Bidder identifier"
    },
    "requiredDocumentId": {
      "type": "string",
      "description": "Optional identifier of the matched tender requirement"
    },
    "documentType": {
      "type": "string",
      "description": "Classified document type (e.g. GST Certificate, CA Certificate)"
    },
    "fileName": {
      "type": "string",
      "description": "Original file name of the upload"
    },
    "fileSize": {
      "type": "integer",
      "minimum": 0,
      "description": "Size in bytes"
    },
    "fileType": {
      "type": "string",
      "description": "MIME type or file extension (e.g. application/pdf, .pdf)"
    },
    "storagePath": {
      "type": "string",
      "description": "MinIO / S3 object storage key path"
    },
    "pageCount": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Number of pages"
    },
    "status": {
      "type": "string",
      "description": "Processing status (e.g. uploaded, processing, preprocessed, extracted, evaluated, failed)"
    },
    "errorMessage": {
      "type": "string",
      "description": "Error details if processing failed"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of creation"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    }
  },
  "required": [
    "id",
    "tenderId",
    "bidderId",
    "fileName",
    "fileSize",
    "fileType",
    "storagePath",
    "pageCount",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}