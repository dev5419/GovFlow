{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govflow.internal/schemas/bidder.schema.json",
  "title": "Bidder",
  "description": "Company or vendor submitting a bid package for tender evaluation per PRD §10",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the bidder"
    },
    "tenderId": {
      "type": "string",
      "description": "Associated Tender identifier"
    },
    "name": {
      "type": "string",
      "description": "Legal entity name of the bidder"
    },
    "registrationNumber": {
      "type": "string",
      "description": "Corporate registration or incorporation number"
    },
    "gstin": {
      "type": "string",
      "description": "Primary GST identification number"
    },
    "pan": {
      "type": "string",
      "description": "Permanent Account Number"
    },
    "udyamNumber": {
      "type": "string",
      "description": "MSME / Udyam registration number"
    },
    "status": {
      "type": "string",
      "description": "Current processing or compliance state (e.g. submitted, processing, evaluated, compliant, needs_review, non_compliant)"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of creation"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    }
  },
  "required": [
    "id",
    "tenderId",
    "name",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}